# --- App ---
NODE_ENV=development
PORT=5000
# Your deployed Netlify site URL in production (e.g. https://your-site.netlify.app)
CLIENT_URL=http://localhost:5173
# Comma-separated if the frontend is reachable at more than one origin
# during development (e.g. http://localhost:5173,http://192.168.1.5:5173).
# Same as CLIENT_URL in production — used to build sitemap.xml <loc> entries.
# Falls back to CLIENT_URL if unset.
SITE_URL=

# --- Database (MongoDB Atlas) ---
# From Atlas: Connect > Drivers > copy the connection string, then fill in
# your database user's password and the database name.
MONGODB_URI=
# Set to "true" only if you hit `querySrv ETIMEOUT` connecting to Atlas
# locally (a known DNS issue on some networks/ISPs, common on Windows).
# Leave unset in production — Render's own DNS resolver doesn't have this
# problem, so forcing Google's DNS there would be solving a problem that
# doesn't exist.
FORCE_GOOGLE_DNS=

# --- Auth ---
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Email (never expose these to the frontend) ---
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
CONTACT_RECEIVER_EMAIL=

# --- Cloudinary (preview images, private original files, attachments) ---
# From your Cloudinary dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
